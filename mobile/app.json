{
  "expo": {
    "name": "LeadsArrow",
    "slug": "leadsarrow",
    "version": "1.0.2",
    "orientation": "portrait",
    "scheme": "leadsarrow",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.leadsarrow.mobile"
    },
    "android": {
      "package": "com.leadsarrow.app",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
