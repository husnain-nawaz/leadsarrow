rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidCustomLead(data) {
      return data.keys().hasAll([
        'ownerId', 'companyName', 'domain', 'industry', 'employeeRange',
        'revenueRange', 'country', 'city', 'contactName', 'contactTitle',
        'seniority', 'department', 'contactEmail', 'contactPhone',
        'verificationStatus', 'fundingStage', 'techStack', 'buyingIntentScore',
        'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'companyName', 'domain', 'industry', 'employeeRange',
        'revenueRange', 'country', 'city', 'contactName', 'contactTitle',
        'seniority', 'department', 'contactEmail', 'contactPhone',
        'verificationStatus', 'fundingStage', 'techStack', 'buyingIntentScore',
        'createdAt', 'updatedAt'
      ]) &&
      data.ownerId == request.auth.uid &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.companyName is string && data.companyName.size() >= 1 && data.companyName.size() <= 160 &&
      data.domain is string && data.domain.size() >= 1 && data.domain.size() <= 160 &&
      data.industry is string && data.industry.size() >= 1 && data.industry.size() <= 100 &&
      data.employeeRange is string && data.employeeRange.size() >= 1 && data.employeeRange.size() <= 50 &&
      data.revenueRange is string && data.revenueRange.size() >= 1 && data.revenueRange.size() <= 60 &&
      data.country is string && data.country.size() >= 1 && data.country.size() <= 80 &&
      data.city is string && data.city.size() >= 1 && data.city.size() <= 80 &&
      data.contactName is string && data.contactName.size() >= 1 && data.contactName.size() <= 120 &&
      data.contactTitle is string && data.contactTitle.size() >= 1 && data.contactTitle.size() <= 120 &&
      data.seniority is string && data.seniority.size() >= 1 && data.seniority.size() <= 60 &&
      data.department is string && data.department.size() >= 1 && data.department.size() <= 80 &&
      data.contactEmail is string && data.contactEmail.size() >= 3 && data.contactEmail.size() <= 160 &&
      data.contactPhone is string && data.contactPhone.size() >= 3 && data.contactPhone.size() <= 60 &&
      data.verificationStatus is string && data.verificationStatus.size() <= 30 &&
      (data.verificationStatus == 'Verified' || data.verificationStatus == 'Catch-All' || data.verificationStatus == 'Pending') &&
      data.fundingStage is string && data.fundingStage.size() >= 1 && data.fundingStage.size() <= 60 &&
      data.techStack is string && data.techStack.size() >= 1 && data.techStack.size() <= 300 &&
      data.buyingIntentScore is int && data.buyingIntentScore >= 0 && data.buyingIntentScore <= 100 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidSavedList(data) {
      return data.keys().hasAll([
        'ownerId', 'name', 'description', 'leadIdsCsv', 'filterSummary',
        'leadCount', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'ownerId', 'name', 'description', 'leadIdsCsv', 'filterSummary',
        'leadCount', 'createdAt', 'updatedAt'
      ]) &&
      data.ownerId == request.auth.uid &&
      data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.description is string && data.description.size() >= 0 && data.description.size() <= 300 &&
      data.leadIdsCsv is string && data.leadIdsCsv.size() >= 0 && data.leadIdsCsv.size() <= 2000 &&
      data.filterSummary is string && data.filterSummary.size() >= 0 && data.filterSummary.size() <= 500 &&
      data.leadCount is int && data.leadCount >= 0 && data.leadCount <= 100000 &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    match /custom_leads/{leadId} {
      allow get: if isVerifiedUser() && isValidId(leadId) && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(leadId) && isValidCustomLead(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(leadId) && isValidCustomLead(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'companyName', 'domain', 'industry', 'employeeRange', 'revenueRange',
          'country', 'city', 'contactName', 'contactTitle', 'seniority',
          'department', 'contactEmail', 'contactPhone', 'verificationStatus',
          'fundingStage', 'techStack', 'buyingIntentScore', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(leadId) && existing().ownerId == request.auth.uid;
    }

    match /saved_lists/{listId} {
      allow get: if isVerifiedUser() && isValidId(listId) && existing().ownerId == request.auth.uid;
      allow list: if isVerifiedUser() && existing().ownerId == request.auth.uid;
      allow create: if isVerifiedUser() && isValidId(listId) && isValidSavedList(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() && isValidId(listId) && isValidSavedList(incoming()) &&
        existing().ownerId == request.auth.uid &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'description', 'leadIdsCsv', 'filterSummary', 'leadCount', 'updatedAt'
        ]);
      allow delete: if isVerifiedUser() && isValidId(listId) && existing().ownerId == request.auth.uid;
    }
  }
}
